/* REXX */
ADDRESS ISPEXEC
"LIBDEF ISPPLIB DATASET ID('Z72304.PANELS')"
MSG1 = ''; MSG2 = ''; MSG3 = ''; MSG4 = ''
DO FOREVER
   ZCMD = ''
   "DISPLAY PANEL(RECONM)"
   IF RC > 0 THEN LEAVE
   MSG1 = ''; MSG2 = ''; MSG3 = ''; MSG4 = ''
   SELECT
      WHEN ZCMD = '1' THEN CALL STATS
      WHEN ZCMD = '2' THEN CALL SUBMITJ
      WHEN ZCMD = '3' THEN CALL MONITOR
      WHEN ZCMD = '4' THEN "BROWSE DATASET('Z72304.RECON.MATCHED')"
      WHEN ZCMD = '5' THEN "BROWSE DATASET('Z72304.RECON.UNMATCH')"
      WHEN ZCMD = '6' THEN "BROWSE DATASET('Z72304.RECON.ERRORS')"
      WHEN ZCMD = '7' THEN CALL SUBMITDB2
      OTHERWISE MSG1 = 'INVALID OPTION - ENTER 1 TO 7'
   END
END
"LIBDEF ISPPLIB"
EXIT

STATS:
   MSG1 = 'INPUT  FILE1 RECORDS : ' COUNTREC('Z72304.RECON.IN1')
   MSG2 = 'INPUT  FILE2 RECORDS : ' COUNTREC('Z72304.RECON.IN2')
   MSG3 = 'MATCHED/UNMATCHED    : ' COUNTREC('Z72304.RECON.MATCHED') ,
          '/' COUNTREC('Z72304.RECON.UNMATCH')
   MSG4 = 'ERROR RECORDS        : ' COUNTREC('Z72304.RECON.ERRORS')
   RETURN

SUBMITJ:
   X = OUTTRAP('SB.')
   ADDRESS TSO "SUBMIT 'Z72304.JCL(RECON)'"
   X = OUTTRAP('OFF')
   MSG1 = 'JOB SUBMITTED. USE OPTION 3 TO CHECK STATUS.'
   IF SB.0 > 0 THEN MSG2 = SB.1
   RETURN

MONITOR:
   X = OUTTRAP('ST.')
   ADDRESS TSO "STATUS Z72304E"
   X = OUTTRAP('OFF')
   IF ST.0 = 0 THEN MSG1 = 'NO JOB FOUND FOR Z72304E'
   ELSE DO
      MSG1 = ST.1
      IF ST.0 > 1 THEN MSG2 = ST.2
      IF ST.0 > 2 THEN MSG3 = ST.3
   END
   RETURN

SUBMITDB2:
   X = OUTTRAP('SB.')
   ADDRESS TSO "SUBMIT 'Z72304.JCL(RUNDB2)'"
   SUBRC = RC
   X = OUTTRAP('OFF')

   IF SUBRC = 0 THEN
      MSG1 = 'DB2 JOB SUBMITTED. CHECK JOBS LIST FOR OUTPUT.'
   ELSE
      MSG1 = 'DB2 JOB SUBMISSION FAILED - CHECK MESSAGE.'

   IF SB.0 > 0 THEN MSG2 = SB.1
   RETURN

COUNTREC: PROCEDURE
   ARG DSN
   ADDRESS TSO
   "ALLOC F(CNTDD) DA('"DSN"') SHR REUSE"
   IF RC <> 0 THEN RETURN 'N/A'
   "EXECIO * DISKR CNTDD (STEM REC. FINIS"
   N = REC.0
   "FREE F(CNTDD)"
   RETURN N
