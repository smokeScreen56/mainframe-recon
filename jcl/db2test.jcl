//Z72304D JOB (FB3),'DB2 TEST',CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
//RUN      EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=DSND10.SDSNLOAD
//         DD DISP=SHR,DSN=DSND10.DBDG.SDSNEXIT
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
 DSN SYSTEM(DBDG)
 RUN PROGRAM(DSNTEP2) PLAN(DSNTEPD1) -
     LIB('DSND10.DBDG.RUNLIB.LOAD')
 END
//SYSIN    DD *
 DECLARE GLOBAL TEMPORARY TABLE SESSION.RECON1
   (KEY1 CHAR(6), AMT CHAR(10)) ON COMMIT PRESERVE ROWS;
 INSERT INTO SESSION.RECON1 VALUES ('A00001','100.00');
 SELECT * FROM SESSION.RECON1;
 SELECT COUNT(*) FROM IBMUSER.TECHTEAM;
 SELECT * FROM IBMUSER.ZDAY FETCH FIRST 5 ROWS ONLY;
 CREATE TABLE Z72304.TEST1 (K CHAR(6)) IN DATABASE Z72304;
/*