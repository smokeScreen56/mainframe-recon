//Z72304I JOB (FB3),'BIND RECON02',CLASS=A,MSGCLASS=H,
//         NOTIFY=&SYSUID,REGION=0M
//DSNTSO   EXEC PGM=IKJEFT01,REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&SYSUID..LOAD
//         DD DISP=SHR,DSN=ZXP.PUBLIC.LOAD
//         DD DISP=SHR,DSN=DSND10.SDSNLOAD
//         DD DISP=SHR,DSN=DSND10.SDSNLOD2
//DBRMLIB  DD DISP=SHR,DSN=&SYSUID..DBRMLIB
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=EXECSYS
DSN SYSTEM(DBDG)
BIND PLAN(&SYSUID.) MEMBER(RECON02) ACTION(REPLACE) -
     VALIDATE(RUN) ISOLATION(CS)
END
