//Z73961E JOB (FB3),'RECON',CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
//DEL     EXEC PGM=IEFBR14
//D1       DD DSN=Z73961.RECON.MATCHED,DISP=(MOD,DELETE),SPACE=(TRK,1)
//D2       DD DSN=Z73961.RECON.UNMATCH,DISP=(MOD,DELETE),SPACE=(TRK,1)
//D3       DD DSN=Z73961.RECON.ERRORS,DISP=(MOD,DELETE),SPACE=(TRK,1)
//SORT1   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=Z73961.RECON.IN1,DISP=SHR
//SORTOUT  DD DSN=&&S1,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD *
  SORT FIELDS=(1,6,CH,A)
/*
//SORT2   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=Z73961.RECON.IN2,DISP=SHR
//SORTOUT  DD DSN=&&S2,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD *
  SORT FIELDS=(11,6,CH,A)
/*
//RUN     EXEC PGM=RECON01
//STEPLIB  DD DSN=Z73961.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//IN1      DD DSN=&&S1,DISP=(OLD,DELETE)
//IN2      DD DSN=&&S2,DISP=(OLD,DELETE)
//MATCHED  DD DSN=Z73961.RECON.MATCHED,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//UNMATCH  DD DSN=Z73961.RECON.UNMATCH,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//ERRFILE  DD DSN=Z73961.RECON.ERRORS,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)