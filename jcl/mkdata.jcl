//            UNIT=SYSDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSUT1   DD *
100003ROHAN SHARMA        000015000
100001ASHA PATIL          000020000
100005MEERA IYER          000007500
